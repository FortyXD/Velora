[Unit]
Description=Velora login wallpaper publisher
Requires=velora-greeter-wallpaper.socket
After=systemd-logind.service

[Service]
ExecStart=/usr/bin/python3 -I /usr/lib/velora/greeter-wallpaper.py serve
User=velora-greeter-sync
Group=velora-greeter-sync
StateDirectory=velora-greeter
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
MemoryMax=256M
CPUQuota=50%
TasksMax=16
Nice=10
LimitCORE=0
LogRateLimitIntervalSec=30s
LogRateLimitBurst=5

