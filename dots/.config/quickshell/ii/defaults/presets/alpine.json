{
    "version": 1,
    "name": "Alpine glow",
    "icon": "landscape",
    "order": 21,
    "description": "Sunset over the Matterhorn in light colors, with a floating bar",
    "wallpaperPreview": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/Matterhorn_sunset_2016_%28Unsplash%29.jpg/960px-Matterhorn_sunset_2016_%28Unsplash%29.jpg",
    "credits": {
        "title": "Matterhorn sunset 2016 (Unsplash)",
        "author": "Sam Ferrara samferrara",
        "license": "CC0",
        "page": "https://commons.wikimedia.org/wiki/File:Matterhorn_sunset_2016_(Unsplash).jpg"
    },
    "bar": {
        "config": {
            "bar": {
                "layout": null,
                "verticalLayout": null,
                "style": {
                    "thickness": -1,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "filled",
                    "edgePadding": -1,
                    "floatMargin": 8,
                    "radius": -1,
                    "textShadow": false,
                    "glass": false
                },
                "cornerStyle": 1,
                "showBackground": true,
                "borderless": false,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": true,
                    "automatic": true,
                    "backgroundTransparency": 0.11,
                    "contentTransparency": 0.57
                },
                "palette": {
                    "type": "scheme-content"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 16,
            "decoration:blur:enabled": true,
            "decoration:blur:passes": 3,
            "decoration:blur:size": 10,
            "decoration:shadow:enabled": true,
            "decoration:dim_inactive": true,
            "general:border_size": 1
        },
        "mode": "light"
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": true,
                "hoverToReveal": true,
                "magnification": true,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": false
                    },
                    "media": {
                        "enable": false
                    },
                    "calendar": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "material",
        "config": {
            "appearance": {
                "animationSpeed": 1
            }
        },
        "hyprland": {
            "general:gaps_in": 5,
            "general:gaps_out": 10,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        },
        "wallpaper": "https://upload.wikimedia.org/wikipedia/commons/2/21/Matterhorn_sunset_2016_%28Unsplash%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original"
    }
}
