{
    "version": 1,
    "name": "Folis",
    "icon": "home",
    "order": 0,
    "description": "The look Folis ships with: hugging bar, soft blur, Material motion",
    "bar": {
        "config": {
            "bar": {
                "layout": null,
                "verticalLayout": null,
                "style": {
                    "thickness": -1,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "filled",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": false,
                    "glass": false
                },
                "cornerStyle": 0,
                "showBackground": true,
                "borderless": false,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": true,
                    "automatic": true,
                    "backgroundTransparency": 0.11,
                    "contentTransparency": 0.57
                },
                "palette": {
                    "type": "auto"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 18,
            "decoration:blur:enabled": true,
            "decoration:blur:passes": 3,
            "decoration:blur:size": 10,
            "decoration:shadow:enabled": true,
            "decoration:dim_inactive": true,
            "general:border_size": 1
        },
        "mode": "dark"
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": true,
                "hoverToReveal": true,
                "magnification": true,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": false
                    },
                    "media": {
                        "enable": false
                    },
                    "calendar": {
                        "enable": false
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "material",
        "config": {
            "appearance": {
                "animationSpeed": 1
            }
        },
        "hyprland": {
            "general:gaps_in": 4,
            "general:gaps_out": 5,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        }
    }
}
