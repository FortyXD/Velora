{
    "version": 1,
    "name": "Deep ocean",
    "icon": "water",
    "order": 25,
    "description": "Sharks in stylized waves, a full dashboard bar hugging the top, deep blue",
    "wallpaperPreview": "https://th.wallhaven.cc/lg/m9/m9wjv9.jpg",
    "credits": {
        "title": "Sharks",
        "author": "Tyler Smith",
        "license": "Wallhaven",
        "page": "https://www.artstation.com/artwork/oADZXz"
    },
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": true,
                    "actions": {
                        "start": {
                            "click": "sidebarLeft",
                            "scroll": "brightness"
                        },
                        "centerEnd": {
                            "click": "sidebarRight"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "lsb",
                                "type": "leftSidebarButton"
                            },
                            {
                                "uid": "res",
                                "type": "resources",
                                "pill": true
                            },
                            {
                                "uid": "net",
                                "type": "networkSpeed",
                                "hideAt": 1
                            }
                        ],
                        "centerStart": [
                            {
                                "uid": "isl",
                                "type": "island",
                                "pill": true,
                                "hideAt": 2
                            }
                        ],
                        "center": [
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            }
                        ],
                        "centerEnd": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true,
                                "fill": true
                            },
                            {
                                "uid": "ub",
                                "type": "utilButtons",
                                "pill": true,
                                "hideAt": 1
                            }
                        ],
                        "end": [
                            {
                                "uid": "wx",
                                "type": "weather",
                                "pill": true
                            },
                            {
                                "uid": "upd",
                                "type": "updates"
                            },
                            {
                                "uid": "sp",
                                "type": "spacer"
                            },
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "bat",
                                "type": "battery",
                                "pill": true
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": -1,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "filled",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": false,
                    "glass": false
                },
                "cornerStyle": 0,
                "showBackground": true,
                "borderless": false,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true,
                "weather": {
                    "enable": true
                }
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": true,
                    "automatic": true,
                    "backgroundTransparency": 0.11,
                    "contentTransparency": 0.57
                },
                "palette": {
                    "type": "scheme-tonal-spot"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 12,
            "decoration:blur:enabled": true,
            "decoration:blur:passes": 3,
            "decoration:blur:size": 10,
            "decoration:shadow:enabled": true,
            "decoration:dim_inactive": true,
            "general:border_size": 1
        },
        "mode": "dark",
        "accent": "#2979FF"
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": true,
                "hoverToReveal": true,
                "magnification": true,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy",
                        "style": "cookie",
                        "styleLocked": "cookie",
                        "cookie": {
                            "aiStyling": false,
                            "sides": 10,
                            "dialNumberStyle": "full",
                            "hourHandStyle": "fill",
                            "minuteHandStyle": "medium",
                            "secondHandStyle": "dot",
                            "dateStyle": "bubble",
                            "timeIndicators": true,
                            "hourMarks": true,
                            "dateInClock": true,
                            "constantlyRotate": false,
                            "useSineCookie": false
                        },
                        "digital": {
                            "adaptiveAlignment": true,
                            "showDate": true,
                            "animateChange": true,
                            "vertical": false,
                            "font": {
                                "family": "Google Sans Flex",
                                "weight": 350,
                                "width": 100,
                                "size": 90,
                                "roundness": 0
                            }
                        }
                    },
                    "cardStyle": "tonal",
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "media": {
                        "enable": false
                    },
                    "calendar": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "fast",
        "config": {
            "appearance": {
                "animationSpeed": 1.2
            }
        },
        "hyprland": {
            "general:gaps_in": 4,
            "general:gaps_out": 8,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        },
        "wallpaper": "https://w.wallhaven.cc/full/m9/wallhaven-m9wjv9.jpg"
    }
}
