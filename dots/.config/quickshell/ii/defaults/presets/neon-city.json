{
    "version": 1,
    "name": "Neon city",
    "icon": "location_city",
    "order": 21,
    "description": "Rainy streets at night, a thin see-through bar with outlines, cyan light",
    "wallpaperPreview": "https://th.wallhaven.cc/lg/dg/dgryeg.jpg",
    "credits": {
        "title": "Neon street",
        "author": "Pc7",
        "license": "Wallhaven",
        "page": "https://wallhaven.cc/w/dgryeg"
    },
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": true,
                    "actions": {
                        "start": {
                            "scroll": "workspaces"
                        },
                        "center": {
                            "click": "sidebarRight"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            },
                            {
                                "uid": "aw",
                                "type": "activeWindow",
                                "hideAt": 1
                            }
                        ],
                        "centerStart": [],
                        "center": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true,
                                "options": {
                                    "showDate": true
                                }
                            }
                        ],
                        "centerEnd": [],
                        "end": [
                            {
                                "uid": "net",
                                "type": "networkSpeed",
                                "hideAt": 1
                            },
                            {
                                "uid": "res",
                                "type": "resources",
                                "pill": true,
                                "hideAt": 2
                            },
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": 32,
                    "backgroundOpacity": 0.45,
                    "islands": false,
                    "pillStyle": "outlined",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": true,
                    "glass": true
                },
                "cornerStyle": 2,
                "showBackground": true,
                "borderless": false,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true,
                "weather": {
                    "enable": false
                }
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": true,
                    "automatic": false,
                    "backgroundTransparency": 0.18,
                    "contentTransparency": 0.5
                },
                "palette": {
                    "type": "scheme-fidelity"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 6,
            "decoration:blur:enabled": true,
            "decoration:blur:passes": 2,
            "decoration:blur:size": 6,
            "decoration:shadow:enabled": true,
            "decoration:dim_inactive": true,
            "general:border_size": 2
        },
        "mode": "dark",
        "accent": "#00E5FF"
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": false,
                "hoverToReveal": true,
                "magnification": true,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy",
                        "style": "digital",
                        "styleLocked": "digital",
                        "cookie": {
                            "aiStyling": false,
                            "sides": 14,
                            "dialNumberStyle": "full",
                            "hourHandStyle": "fill",
                            "minuteHandStyle": "medium",
                            "secondHandStyle": "dot",
                            "dateStyle": "bubble",
                            "timeIndicators": true,
                            "hourMarks": false,
                            "dateInClock": true,
                            "constantlyRotate": false,
                            "useSineCookie": false
                        },
                        "digital": {
                            "adaptiveAlignment": true,
                            "showDate": true,
                            "animateChange": true,
                            "vertical": false,
                            "font": {
                                "family": "Google Sans Flex",
                                "weight": 300,
                                "width": 75,
                                "size": 80,
                                "roundness": 0
                            }
                        }
                    },
                    "cardStyle": "transparent",
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "media": {
                        "enable": false
                    },
                    "calendar": {
                        "enable": false
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "fast",
        "config": {
            "appearance": {
                "animationSpeed": 1.3
            }
        },
        "hyprland": {
            "general:gaps_in": 3,
            "general:gaps_out": 6,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        },
        "wallpaper": "https://w.wallhaven.cc/full/dg/wallhaven-dgryeg.png"
    }
}
