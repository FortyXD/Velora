{
    "version": 1,
    "name": "Material Glass",
    "icon": "blur_on",
    "order": 1,
    "description": "Frosted islands with music in the middle, round corners and springy motion",
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": true,
                    "actions": {
                        "start": {
                            "click": "sidebarLeft",
                            "scroll": "brightness"
                        },
                        "centerEnd": {
                            "click": "sidebarRight"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "lsb",
                                "type": "leftSidebarButton"
                            },
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            }
                        ],
                        "centerStart": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true,
                                "options": {
                                    "showDate": true
                                }
                            }
                        ],
                        "center": [
                            {
                                "uid": "isl",
                                "type": "island",
                                "pill": true,
                                "hideAt": 2
                            }
                        ],
                        "centerEnd": [
                            {
                                "uid": "res",
                                "type": "resources",
                                "pill": true,
                                "hideAt": 2
                            }
                        ],
                        "end": [
                            {
                                "uid": "sp",
                                "type": "spacer"
                            },
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            },
                            {
                                "uid": "bat",
                                "type": "battery",
                                "pill": true
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": -1,
                    "backgroundOpacity": -1,
                    "islands": true,
                    "pillStyle": "filled",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": 20,
                    "textShadow": false,
                    "glass": true
                },
                "cornerStyle": 0,
                "showBackground": true,
                "borderless": false,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true,
                "weather": {
                    "enable": false
                }
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": true,
                    "automatic": false,
                    "backgroundTransparency": 0.3,
                    "contentTransparency": 0.6
                },
                "palette": {
                    "type": "auto"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 22,
            "decoration:blur:enabled": true,
            "decoration:blur:passes": 4,
            "decoration:blur:size": 8,
            "decoration:shadow:enabled": true,
            "decoration:dim_inactive": true,
            "general:border_size": 1
        },
        "mode": "dark"
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": true,
                "hoverToReveal": true,
                "magnification": true,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": false
                    },
                    "media": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "calendar": {
                        "enable": false
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "smooth",
        "config": {
            "appearance": {
                "animationSpeed": 1
            }
        },
        "hyprland": {
            "general:gaps_in": 6,
            "general:gaps_out": 12,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        }
    }
}
