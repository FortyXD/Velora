{
    "version": 1,
    "name": "Pastel sky",
    "icon": "cloud",
    "order": 22,
    "description": "A soft pink planet in light colors, a rounded floating bar at the bottom",
    "wallpaperPreview": "https://th.wallhaven.cc/lg/ox/oxeo25.jpg",
    "credits": {
        "title": "Alien Moon",
        "author": "rmRadev",
        "license": "Wallhaven",
        "page": "https://www.deviantart.com/rmradev/art/Alien-Moon-743912901"
    },
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": true,
                    "actions": {
                        "start": {
                            "click": "sidebarLeft",
                            "scroll": "brightness"
                        },
                        "centerEnd": {
                            "click": "sidebarRight"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "lsb",
                                "type": "leftSidebarButton"
                            },
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            }
                        ],
                        "centerStart": [],
                        "center": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true,
                                "options": {
                                    "showDate": true
                                }
                            },
                            {
                                "uid": "dark",
                                "type": "darkMode",
                                "pill": true
                            },
                            {
                                "uid": "night",
                                "type": "nightLight",
                                "pill": true
                            }
                        ],
                        "centerEnd": [],
                        "end": [
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            },
                            {
                                "uid": "bat",
                                "type": "battery",
                                "pill": true
                            },
                            {
                                "uid": "pwr",
                                "type": "session"
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": 44,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "filled",
                    "edgePadding": -1,
                    "floatMargin": 12,
                    "radius": 24,
                    "textShadow": false,
                    "glass": false
                },
                "cornerStyle": 1,
                "showBackground": true,
                "borderless": false,
                "bottom": true,
                "vertical": false,
                "floatStyleShadow": true,
                "weather": {
                    "enable": false
                }
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": true,
                    "automatic": true,
                    "backgroundTransparency": 0.11,
                    "contentTransparency": 0.57
                },
                "palette": {
                    "type": "scheme-tonal-spot"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 22,
            "decoration:blur:enabled": true,
            "decoration:blur:passes": 3,
            "decoration:blur:size": 10,
            "decoration:shadow:enabled": true,
            "decoration:dim_inactive": true,
            "general:border_size": 1
        },
        "mode": "light",
        "accent": "#B388FF"
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": false,
                "hoverToReveal": true,
                "magnification": true,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy",
                        "style": "cookie",
                        "styleLocked": "cookie",
                        "cookie": {
                            "aiStyling": false,
                            "sides": 8,
                            "dialNumberStyle": "dots",
                            "hourHandStyle": "hollow",
                            "minuteHandStyle": "thin",
                            "secondHandStyle": "line",
                            "dateStyle": "rect",
                            "timeIndicators": true,
                            "hourMarks": false,
                            "dateInClock": true,
                            "constantlyRotate": false,
                            "useSineCookie": false
                        },
                        "digital": {
                            "adaptiveAlignment": true,
                            "showDate": true,
                            "animateChange": true,
                            "vertical": false,
                            "font": {
                                "family": "Google Sans Flex",
                                "weight": 350,
                                "width": 100,
                                "size": 90,
                                "roundness": 0
                            }
                        }
                    },
                    "cardStyle": "tonal",
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": false
                    },
                    "media": {
                        "enable": false
                    },
                    "calendar": {
                        "enable": true,
                        "placementStrategy": "leastBusy"
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "smooth",
        "config": {
            "appearance": {
                "animationSpeed": 0.9
            }
        },
        "hyprland": {
            "general:gaps_in": 6,
            "general:gaps_out": 14,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        },
        "wallpaper": "https://w.wallhaven.cc/full/ox/wallhaven-oxeo25.jpg"
    }
}
