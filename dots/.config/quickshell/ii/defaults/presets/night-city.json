                                "pill": true
                            },
                            {
                                "uid": "aw",
                                "type": "activeWindow",
                                "hideAt": 1
                            }
                        ],
                        "centerStart": [],
                        "center": [],
                        "centerEnd": [],
                        "end": [
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            },
                            {
                                "uid": "clk",
                                "type": "clock",
                                "options": {
                                    "showDate": true
                                }
                            }
                        ]
                    }
