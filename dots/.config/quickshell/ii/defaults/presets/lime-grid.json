                            "sides": 14,
                            "dialNumberStyle": "full",
                            "hourHandStyle": "fill",
                            "minuteHandStyle": "medium",
                            "secondHandStyle": "dot",
                            "dateStyle": "bubble",
                            "timeIndicators": true,
