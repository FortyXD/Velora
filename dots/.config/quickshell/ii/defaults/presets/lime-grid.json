{
    "version": 1,
    "name": "Lime grid",
    "icon": "grid_4x4",
    "order": 41,
    "description": "An animated neon grid running to a yellow sun, lime accents and a thin outlined bar",
    "credits": {
        "title": "Neon grid",
        "author": "Velora",
        "license": "Drawn by the shell",
        "page": ""
    },
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": true,
                    "actions": {
                        "start": {
                            "click": "sidebarLeft",
                            "scroll": "brightness"
                        },
                        "centerEnd": {
                            "click": "sidebarRight"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "search",
                                "type": "launcher"
                            },
                            {
                                "uid": "win",
                                "type": "activeWindow"
                            }
                        ],
                        "centerStart": [],
                        "center": [
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            }
                        ],
                        "centerEnd": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true
                            }
                        ],
                        "end": [
                            {
                                "uid": "res",
                                "type": "resources",
                                "pill": true
                            },
                            {
                                "uid": "net",
                                "type": "networkSpeed"
                            },
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": 32,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "outlined",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": false,
                    "glass": false
