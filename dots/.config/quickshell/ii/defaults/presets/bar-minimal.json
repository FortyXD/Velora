{
    "version": 1,
    "name": "Minimal bar",
    "icon": "crop_square",
    "order": 11,
    "description": "Workspaces, clock and status on a see-through bar",
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": false,
                    "actions": {
                        "start": {
                            "click": "overview",
                            "scroll": "workspaces"
                        },
                        "center": {
                            "click": "sidebarRight"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            }
                        ],
                        "centerStart": [],
                        "center": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true
                            }
                        ],
                        "centerEnd": [],
                        "end": [
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": -1,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "none",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": true,
                    "glass": false
                },
                "cornerStyle": 0,
                "showBackground": false,
                "borderless": true,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true
            }
        }
    }
}
