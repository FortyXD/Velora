{
    "version": 1,
    "name": "Monochrome",
    "icon": "contrast",
    "order": 28,
    "description": "Black and white hills in fog, everything in the middle, plain shapes and almost no motion",
    "wallpaperPreview": "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Forested_hills_in_Lysekil_in_fog_-_B%26W.jpg/960px-Forested_hills_in_Lysekil_in_fog_-_B%26W.jpg",
    "credits": {
        "title": "Forested hills in Lysekil in fog - B&W",
        "author": "W.carter",
        "license": "CC BY-SA 4.0",
        "page": "https://commons.wikimedia.org/wiki/File:Forested_hills_in_Lysekil_in_fog_-_B%26W.jpg"
    },
    "bar": {
        "config": {
            "bar": {
                "layout": {
                    "version": 1,
                    "balanceCenter": true,
                    "actions": {
                        "start": {
                            "click": "overview",
                            "scroll": "workspaces"
                        },
                        "end": {
                            "click": "sidebarRight",
                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "aw",
                                "type": "activeWindow",
                                "hideAt": 1
                            }
                        ],
                        "centerStart": [],
                        "center": [
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            },
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true,
                                "pillBreak": true,
                                "options": {
                                    "showDate": false
                                }
                            }
                        ],
                        "centerEnd": [],
                        "end": [
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            },
                            {
                                "uid": "pwr",
                                "type": "session"
                            }
                        ]
                    }
                },
                "verticalLayout": null,
                "style": {
                    "thickness": 36,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "outlined",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": false,
                    "glass": false
                },
                "cornerStyle": 2,
                "showBackground": true,
                "borderless": false,
                "bottom": false,
                "vertical": false,
                "floatStyleShadow": true,
                "weather": {
                    "enable": false
                }
            }
        }
    },
    "theme": {
        "config": {
            "appearance": {
                "transparency": {
                    "enable": false,
                    "automatic": true,
                    "backgroundTransparency": 0.11,
                    "contentTransparency": 0.57
                },
                "palette": {
                    "type": "scheme-monochrome"
                }
            }
        },
        "hyprland": {
            "decoration:rounding": 6,
            "decoration:blur:enabled": false,
            "decoration:blur:passes": 3,
            "decoration:blur:size": 10,
            "decoration:shadow:enabled": false,
            "decoration:dim_inactive": false,
            "general:border_size": 1
        },
        "mode": "dark",
        "accent": ""
    },
    "dockWidgets": {
        "config": {
            "dock": {
                "enable": true,
                "hoverToReveal": true,
                "magnification": false,
                "monochromeIcons": true
            },
            "background": {
                "widgets": {
                    "clock": {
                        "enable": true,
                        "placementStrategy": "leastBusy",
                        "style": "digital",
                        "styleLocked": "digital",
                        "cookie": {
                            "aiStyling": false,
                            "sides": 14,
                            "dialNumberStyle": "full",
                            "hourHandStyle": "fill",
                            "minuteHandStyle": "medium",
                            "secondHandStyle": "dot",
                            "dateStyle": "bubble",
                            "timeIndicators": true,
                            "hourMarks": false,
                            "dateInClock": true,
                            "constantlyRotate": false,
                            "useSineCookie": false
                        },
                        "digital": {
                            "adaptiveAlignment": true,
                            "showDate": true,
                            "animateChange": true,
                            "vertical": false,
                            "font": {
                                "family": "Google Sans Flex",
                                "weight": 200,
                                "width": 100,
                                "size": 120,
                                "roundness": 0
                            }
                        }
                    },
                    "cardStyle": "transparent",
                    "weather": {
                        "enable": false
                    },
                    "systemMonitor": {
                        "enable": false
                    },
                    "media": {
                        "enable": false
                    },
                    "calendar": {
                        "enable": false
                    },
                    "countdown": {
                        "enable": false
                    },
                    "note": {
                        "enable": false
                    },
                    "pomodoro": {
                        "enable": false
                    }
                }
            }
        }
    },
    "wallpaperAnimations": {
        "animationProfile": "minimal",
        "config": {
            "appearance": {
                "animationSpeed": 1.5
            }
        },
        "hyprland": {
            "general:gaps_in": 2,
            "general:gaps_out": 4,
            "animations:enabled": true,
            "misc:animate_manual_resizes": false,
            "misc:animate_mouse_windowdragging": false
        },
        "wallpaper": "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Forested_hills_in_Lysekil_in_fog_-_B%26W.jpg/3840px-Forested_hills_in_Lysekil_in_fog_-_B%26W.jpg"
    }
}
