                "verticalLayout": null,
                "style": {
                    "thickness": -1,
                    "backgroundOpacity": -1,
                    "islands": false,
                    "pillStyle": "filled",
                    "edgePadding": -1,
                    "floatMargin": -1,
                    "radius": -1,
                    "textShadow": false,
