                            "scroll": "volume"
                        }
                    },
                    "zones": {
                        "start": [
                            {
                                "uid": "lsb",
                                "type": "leftSidebarButton"
                            },
                            {
                                "uid": "res",
                                "type": "resources",
                                "pill": true
                            },
                            {
                                "uid": "net",
                                "type": "networkSpeed",
                                "hideAt": 1
                            }
                        ],
                        "centerStart": [
                            {
                                "uid": "isl",
                                "type": "island",
                                "pill": true,
                                "hideAt": 2
                            }
                        ],
                        "center": [
                            {
                                "uid": "ws",
                                "type": "workspaces",
                                "pill": true
                            }
                        ],
                        "centerEnd": [
                            {
                                "uid": "clk",
                                "type": "clock",
                                "pill": true,
                                "fill": true
                            },
                            {
                                "uid": "ub",
                                "type": "utilButtons",
                                "pill": true,
                                "hideAt": 1
                            }
                        ],
                        "end": [
                            {
                                "uid": "wx",
                                "type": "weather",
                                "pill": true
                            },
                            {
                                "uid": "upd",
                                "type": "updates"
                            },
                            {
                                "uid": "sp",
                                "type": "spacer"
                            },
                            {
                                "uid": "tray",
                                "type": "sysTray",
                                "hideAt": 1
                            },
                            {
                                "uid": "prv",
                                "type": "privacy"
                            },
                            {
                                "uid": "bat",
                                "type": "battery",
                                "pill": true
                            },
                            {
                                "uid": "st",
                                "type": "statusIndicators"
                            }
                        ]
                    }
