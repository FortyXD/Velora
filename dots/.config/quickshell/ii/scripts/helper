#!/bin/sh
# Runs velora-helper wherever it's installed: the shell's PATH needn't include ~/.local/bin.
VELORA_SHELL_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export VELORA_SHELL_DIR
if [ -n "${VELORA_HELPER:-}" ]; then
    exec "$VELORA_HELPER" "$@"
elif [ -x "$HOME/.local/bin/velora-helper" ]; then
    exec "$HOME/.local/bin/velora-helper" "$@"
else
    exec velora-helper "$@"
fi
