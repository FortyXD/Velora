#!/bin/sh
# Runs velora-helper wherever it's installed: the shell's PATH needn't include ~/.local/bin.
case "$0" in
    /*/scripts/helper)
        if [ -L "$0" ]; then
            resolved=$(readlink -f "$0") || exit 1
            VELORA_SHELL_DIR=${resolved%/scripts/helper}
        else
            VELORA_SHELL_DIR=${0%/scripts/helper}
        fi ;;
    *) VELORA_SHELL_DIR=$(CDPATH= cd -P "$(dirname "$(readlink -f "$0")")/.." && pwd) || exit 1 ;;
esac
export VELORA_SHELL_DIR
if [ -n "${VELORA_HELPER:-}" ]; then
    exec "$VELORA_HELPER" "$@"
elif [ -x "$HOME/.local/bin/velora-helper" ]; then
    exec "$HOME/.local/bin/velora-helper" "$@"
else
    exec velora-helper "$@"
fi
