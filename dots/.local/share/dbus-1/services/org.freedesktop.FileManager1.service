# Nautilus also ships /usr/share/dbus-1/services/org.freedesktop.FileManager1.service.
# dbus-broker only accepts a file named after the bus name, so Dolphin's
# org.kde.dolphin.FileManager1.service is ignored. This user file takes priority
# and makes "Show in folder" / "Reveal in File Explorer" open Dolphin.
[D-BUS Service]
Name=org.freedesktop.FileManager1
Exec=/usr/bin/dolphin --daemon
SystemdService=plasma-dolphin.service
