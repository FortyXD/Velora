#!/usr/bin/env bash
set -euo pipefail
velora_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
case "${1:-help}" in
    help|--help|-h) exec "$velora_root/velora" --help ;;
    install|install-files|install-deps)
        velora_action=$1
        shift
        case "$velora_action" in
            install-files) exec "$velora_root/velora" install --skip-packages "$@" ;;
            install-deps) exec "$velora_root/velora" deps "$@" ;;
            *) exec "$velora_root/velora" install "$@" ;;
        esac ;;
    exp-update) shift; exec "$velora_root/velora" update "$@" ;;
    *) exec "$velora_root/velora" "$@" ;;
esac
