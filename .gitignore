/diagnose.result
/cache

# Local workspace metadata and cloud configuration.
/.agents/
/.aws/
/.codex/

# Ignore Python cache files
__pycache__/
*.py[cod]

/dots/.config/quickshell/ii/.qmlls.ini

# exp-update
/.update-lock

# custom os-release
/os-release

# Emacs auto backup file
*~

# Runtime data; never publish local install state or editor files.
/dots/.config/illogical-impulse/installed_*
/dots/.config/illogical-impulse/config.json
/dots/.config/fish/fish_history
/dots/.config/hypr/nvim.log

# Local screenshots and previews produced while testing
/artifacts/
/dots/.config/illogical-impulse/presets/

# Frames of video wallpapers, made by switchwall.sh
/dots/.config/hypr/custom/scripts/mpvpaper_thumbnails/

# Rewritten while the desktop runs: colors made from the wallpaper and the settings app's output.
# install.sh creates the missing ones from the *_default files next to them.
/dots/.config/hypr/custom/shell_settings.json
/dots/.config/hypr/custom/shell_settings.lua
/dots/.config/hypr/custom/monitors.json
/dots/.config/hypr/custom/monitors.lua
/dots/.config/hypr/custom/keybind_overrides.json
/dots/.config/hypr/custom/keybind_overrides.lua
/dots/.config/hypr/custom/gesture_overrides.json
/dots/.config/hypr/custom/gesture_overrides.lua
/dots/.config/hypr/hyprland/colors.lua
/dots/.config/hypr/hyprlock/colors.conf
/dots/.config/fuzzel/fuzzel_theme.ini

# Native helper build output (tools/Cargo.lock is kept)
/tools/target/
